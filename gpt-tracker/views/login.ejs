<div class="formView">
    <h2>Login</h2>
    <form action="/login" method="POST">
        <div class="formGroup">
            <label>Email</label>
            <input type="email" name="email" autocomplete="true" required />
        </div>

        <div class="formGroup">
            <label>Password</label>
            <input type="password" name="password" autocomplete="true" required />
        </div>

        <div class="formGroup">
            <button type="submit">Login</button>
        </div>
    </form>
</div>